{
  "name": "@jlongyam/ansi",
  "version": "1.2.0",
  "description": "ANSI utilities",
  "keywords": [
    "ansi",
    "utility"
  ],
  "author": "jlongyam",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlongyam/ansi.git"
  },
  "homepage": "https://github.com/jlongyam/ansi",
  "devDependencies": {
    "@babel/preset-env": "^7.29.0",
    "@jlongyam/repo": "^2.1.1",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-buble": "^1.0.3",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@web/dev-server": "^0.4.6",
    "fancy-ansi": "^0.1.3",
    "rollup": "^4.57.1",
    "typescript": "^5.9.3"
  },
  "main": "./dist/ansi.cjs",
  "scripts": {
    "build": "rollup -c",
    "types": "tsc",
    "server": "web-dev-server",
    "test:ansi": "node ./test/ansi.test.cjs",
    "test:ansi:mjs": "node ./test/ansi.test.mjs",
    "test:icon": "node ./test/icon/icon.test.cjs",
    "test:icon:mjs": "node ./test/icon/icon.test.mjs",
    "test:code": "node ./test/code/code.test.cjs",
    "test:code:mjs": "node ./test/code/code.test.mjs",
    "test:style": "node ./test/style/style.test.cjs",
    "test:style:mjs": "node ./test/style/style.test.mjs",
    "test:color": "node ./test/color/color.test.cjs",
    "test:color:mjs": "node ./test/color/color.test.mjs",
    "test:color256": "node ./test/color/color256.test.cjs",
    "test:color256:mjs": "node ./test/color/color256.test.mjs",
    "test:colorRgb:mjs": "node ./test/color/colorRgb.test.mjs",
    "test:css": "node ./test/css/css.test.cjs",
    "test:css:mjs": "node ./test/css/css.test.mjs",
    "test:regex": "node ./test/regex/regex.test.cjs",
    "test:regex:mjs": "node ./test/regex/regex.test.mjs",
    "test:html:mjs": "node test/html/html.test.mjs",
    "escheck": "repo escheck ./dist/ansi.cjs ./dist/ansi.js",
    "changelog": "repo changelog"
  },
  "exports": {
    ".": {
      "require": "./dist/ansi.cjs",
      "import": "./dist/ansi.mjs",
      "types": "./dist/ansi.d.mts"
    }
  },
  "files": [
    "dist",
    "test",
    "index.html",
    "color256.png"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com/"
  }
}
